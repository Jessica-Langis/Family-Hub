# Copy this file to .env (local dev) and fill in real values.
# .env is gitignored — never commit real values here or anywhere else in the repo.
# In CI (GitHub Actions), these are injected from repository secrets instead
# of a committed .env file — see .github/workflows/deploy.yml.

VITE_SCRIPT_GROCERY=
VITE_SCRIPT_CHORES=
VITE_SCRIPT_MEAL=
VITE_SCRIPT_TORI=
VITE_SCRIPT_NOVA=

VITE_CALENDAR_EMBED_URL=
VITE_CALENDAR_ICS_URL=

VITE_WEATHER_LAT=
VITE_WEATHER_LON=
VITE_WEATHER_TZ=America/Los_Angeles

# Google Sign-In client ID (OAuth 2.0 Web application credential)
VITE_GOOGLE_CLIENT_ID=

# Dev-only: set to "true" in a gitignored .env.local (not this file) to skip
# the sign-in gate entirely for local layout/framework work. Only takes
# effect in `vite dev` — ignored in production builds regardless of value.
# VITE_SKIP_AUTH=true
